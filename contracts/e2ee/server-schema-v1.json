{
  "version": 1,
  "schemaThrough": 134,
  "productionEnabled": false,
  "meaning": "Complete schema disposition is not complete E2EE product integration. New tables or columns require deliberate reclassification before acceptance.",
  "groups": [
    {
      "id": "identity-security",
      "boundary": "Authoritative account identity, sessions, provider credentials or security evidence; never restored from content archives."
    },
    {
      "id": "billing-authority",
      "boundary": "Authoritative billing, subscription, referral or partner records; encrypted provider requests contain checkout data and result IDs, never the modeling solution. Content restore cannot grant rights."
    },
    {
      "id": "access-authority",
      "boundary": "Server ACL, invitation or presence metadata, separate from encrypted content; membership mutations require signed rotations after cutover. Receipts cannot restore grants."
    },
    {
      "id": "technical-metadata",
      "boundary": "Operational counters, opaque IDs, schedules, consent, notification routing/subscriptions or public-catalogue settings. Not a plaintext-content backup. Scope-aware workers must gate private execution independently."
    },
    {
      "id": "public-content",
      "boundary": "Owner-managed public artwork/catalogue or advertising content, not a personal-content encryption scope."
    },
    {
      "id": "external-provider-copy",
      "boundary": "User-selected external provider copy; provider tokens stay identity authority. Client consent/routing and local pending-operation migration are still required; this is not a claim of secrecy from that provider."
    },
    {
      "id": "independent-message-protocol",
      "boundary": "Existing message ciphertext, devices, read state and membership retain their independent protocol/history. Local key lifecycle/recovery and forward-secrecy ADR remain pending; no new guarantee is claimed."
    },
    {
      "id": "mixed-message-metadata",
      "boundary": "Conversation identity/ACL metadata is server-visible. User-defined title needs explicit encryption/product integration; metadata is not mislabeled as encrypted message content."
    },
    {
      "id": "mixed-account",
      "boundary": "Private preference/reference fields have a targeted legacy fence and source hash; remaining columns retain identity, billing, quota and technical authority. Export adapters must whitelist content fields."
    },
    {
      "id": "mixed-access-content",
      "boundary": "The category title is private content, while permission definitions remain server ACL authority. Existing ACL fence/source hash cover mutations; content archives must exclude permission authority."
    },
    {
      "id": "e2ee-contract",
      "boundary": "New ciphertext-only objects, signed directory/checkpoint/receipt and migration metadata. Runtime contract is inactive; no client root/private key belongs on the server."
    },
    {
      "id": "legacy-private",
      "boundary": "Legacy private content, copied content or private relationship history. Persistent scope fences/source hashing required; actual feature adapters, readback/recovery and separately approved legacy retention/retirement remain pending."
    }
  ],
